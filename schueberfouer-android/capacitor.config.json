{
  "appId": "lu.schueberfouer.game",
  "appName": "Schueberfouer 2026",
  "webDir": "www",
  "backgroundColor": "#05030f",
  "android": {
    "minWebViewVersion": 89,
    "backgroundColor": "#05030f",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 0,
      "backgroundColor": "#05030f",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "SystemBars": {
      "hidden": true,
      "style": "DARK",
      "insetsHandling": "css"
    }
  }
}
